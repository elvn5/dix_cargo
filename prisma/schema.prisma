// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PackageStatus {
  IN_OFFICE
  IN_TRANSIT
  DELIVERED
}

enum ResetRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Package {
  id         Int           @id @default(autoincrement())
  track_code String
  status     PackageStatus @default(IN_TRANSIT)
  user_id    Int
  user       User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  weight     Float?
  price      Float?

  // Группа выдачи: вес и цена выдачи хранятся в группе, а не в каждой посылке
  delivery_group_id Int?
  delivery_group    DeliveryGroup? @relation(fields: [delivery_group_id], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id])
  @@index([track_code])
  @@index([delivery_group_id])
  @@map("packages")
}

/// Одна выдача клиенту: несколько посылок с общим весом и ценой
model DeliveryGroup {
  id       Int       @id @default(autoincrement())
  user_id  Int
  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  weight   Float?
  price    Float?
  packages Package[]

  created_at DateTime @default(now())

  @@index([user_id])
  @@map("delivery_groups")
}

model PromoCode {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  description String?
  claimed_by  Int?
  claimer     User?     @relation(fields: [claimed_by], references: [id])
  claimed_at  DateTime?
  created_at  DateTime  @default(now())

  @@map("promo_codes")
}

model Setting {
  key        String   @id
  value      String
  updated_at DateTime @updatedAt

  @@map("settings")
}

model User {
  id            Int                  @id @default(autoincrement())
  telegram_id   BigInt               @unique
  phone         String               @unique
  full_name     String
  client_code   String               @unique
  packages      Package[]
  promo_codes   PromoCode[]
  reset_requests AccessResetRequest[]
  delivery_groups DeliveryGroup[]

  // Корзина: не null — клиент удалён (вместе с посылками скрыт), можно восстановить
  deleted_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("users")
}

model AccessResetRequest {
  id                    Int                @id @default(autoincrement())
  user_id               Int
  user                  User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  requested_telegram_id BigInt
  status                ResetRequestStatus @default(PENDING)
  created_at            DateTime           @default(now())
  resolved_at           DateTime?

  @@map("access_reset_requests")
}
