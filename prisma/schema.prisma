// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PackageStatus {
  IN_OFFICE
  IN_TRANSIT
  DELIVERED
}

model Package {
  id         Int           @id @default(autoincrement())
  track_code String
  status     PackageStatus @default(IN_TRANSIT)
  user_id    Int
  user       User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  weight     Float?
  price      Float?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("packages")
}

model PromoCode {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  description String?
  claimed_by  Int?
  claimer     User?     @relation(fields: [claimed_by], references: [id])
  claimed_at  DateTime?
  created_at  DateTime  @default(now())

  @@map("promo_codes")
}

model Setting {
  key        String   @id
  value      String
  updated_at DateTime @updatedAt

  @@map("settings")
}

model User {
  id          Int         @id @default(autoincrement())
  telegram_id BigInt      @unique
  phone       String      @unique
  full_name   String
  client_code String      @unique
  packages    Package[]
  promo_codes PromoCode[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("users")
}
